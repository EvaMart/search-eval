# Only experiments/readme_queries needs these. The analyses read files under data/.
# Variable names are the pipeline's (research-software-etl, infrastructure/config.py).

# MongoDB, read-only use: samples tools from `tools` and reads stored v1 queries
# from `semantic_search`.
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PWD=
MONGO_AUTH_SRC=admin
MONGO_DB=
# Collection overrides, if not the pipeline defaults:
# MONGO_TOOLS_COLL=toolsDev
# SEMANTIC_SEARCH_COLL=semantic_search

# Gepeto (BSC LLM provider): query generation.
GEPETO_API_KEY=

# GitHub token, used to fetch READMEs through the github-metadata-api (prompt v2).
GITHUB_TOKEN=
